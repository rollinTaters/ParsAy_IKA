#include <iostream>
#include <string>
#include <vector>
#include <cmath>
#include <serial/serial.h>

#define RPLIDAR_MOTOR 0x02
#define RPLIDAR_SCAN 0x20
#define RPLIDAR_STOP 0xA5

using namespace std;

int main() {
    serial::Serial serialPort;
    string port = "/dev/ttyUSB0"; // RPLidar'ın bağlı olduğu seri port (gerekirse değiştirin)
    int baudrate = 115200;
    serial::Timeout timeout = serial::Timeout::simpleTimeout(1000);

    try {
        serialPort.setPort(port);
        serialPort.setBaudrate(baudrate);
        serialPort.setTimeout(timeout);
        serialPort.open();
    } catch (serial::IOException& e) {
        cerr << "Seri port açılamadı: " << e.what() << endl;
        return 1;
    }

    if (serialPort.isOpen()) {
        cout << "RPLidar seri portu açıldı." << endl;

        // Motoru başlat
        unsigned char startMotor[] = {0xA5, RPLIDAR_MOTOR};
        serialPort.write(startMotor, sizeof(startMotor));
        cout << "RPLidar motoru başlatılıyor..." << endl;

        // Tarama komutunu gönder
        unsigned char startScan[] = {0xA5, RPLIDAR_SCAN};
        serialPort.write(startScan, sizeof(startScan));
        cout << "Tarama başlatılıyor..." << endl;

        while (true) {
            if (serialPort.available() >= 5) {
                unsigned char header[2];
                serialPort.read(header, 2);

                if (header[0] == 0xA5 && header[1] == 0x5A) {
                    unsigned char response[3];
                    serialPort.read(response, 3);

                    int quality = (response[0] >> 2);
                    int start_bit = (response[0] & 0x01);
                    int check_bit = (response[0] & 0x02) >> 1;

                    unsigned char data[4];
                    serialPort.read(data, 4);

                    int raw_distance = data[0] | (data[1] << 8);
                    int raw_angle = data[2] | (data[3] << 8);

                    double distance = raw_distance / 4.0;
                    double angle = (raw_angle >> 1) / 64.0;

                    cout << "Kalite: " << quality << ", Açı: " << angle << " derece, Mesafe: " << distance << " mm" << endl;
                }
            }
            // İstenirse belirli bir süre sonra döngüyü sonlandırabilirsiniz.
            // Örneğin: if (sayac++ > 100) break;
        }

        // Taramayı durdur
        unsigned char stopScan[] = {0xA5, RPLIDAR_STOP};
        serialPort.write(stopScan, sizeof(stopScan));
        cout << "Tarama durduruldu." << endl;

        // Motoru durdur (isteğe bağlı)
        unsigned char stopMotor[] = {0xA5, 0xF5};
        serialPort.write(stopMotor, sizeof(stopMotor));
        cout << "RPLidar motoru durduruldu." << endl;

        serialPort.close();
        cout << "Seri port kapatıldı." << endl;
    } else {
        cerr << "Seri port açılamadı!" << endl;
        return 1;
    }

    return 0;
}
